.env
node_modules/
*.tmp
frontend-logic.js

# Data directory — ignore generated files, keep the two source-of-truth files
data/*
!data/participants.json
!data/predictions.json
!data/feed.json
!data/scoring_ledger.json
# Per-group source-of-truth files (roster + predictions), generated group data stays ignored
!data/groups/
data/groups/*/*
!data/groups/*/participants.json
!data/groups/*/predictions.json
!data/groups/*/feed.json
!data/groups/*/scoring_ledger.json
.vercel
